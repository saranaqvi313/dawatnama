# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Supabase → Project Settings → API → service_role (SECRET: server only, never NEXT_PUBLIC_)
# Used only to record payments and switch Premium on after Safepay confirms a payment.
SUPABASE_SERVICE_ROLE_KEY=
# Your live address (no trailing slash). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app


# --- Premium ----------------------------------------------------------------------------
# Price in rupees. Keep both the same: the first is what is charged, the second is shown.
PREMIUM_PRICE_PKR=1499
NEXT_PUBLIC_PREMIUM_PRICE_PKR=1499

# --- Guest links and bundles (each guest's personal link uses one link) -------------------
SHARE_PRICE_PKR=100
NEXT_PUBLIC_SHARE_PRICE_PKR=100
# Optional: bundle and package prices (defaults shown)
# NEXT_PUBLIC_PRICE_LINKS5_PKR=400
# NEXT_PUBLIC_PRICE_LINKS20_PKR=1400
# NEXT_PUBLIC_PRICE_SHAADI_PKR=3999
# NEXT_PUBLIC_SHAADI_LINKS=50

# --- Sign-in codes by SMS (currently OFF: OTP_ENABLED = false in src/lib/otp.ts) -----------
# "textbee" = SMS from your own Android phone + SIM via textbee.dev (free for 300 SMS/month).
# "demo"    = no SMS, the code is shown on screen (ignored on the live production site).
OTP_PROVIDER=textbee
# textbee.dev → Dashboard → API key
TEXTBEE_API_KEY=
# Optional: send from a specific registered phone (textbee device id)
TEXTBEE_DEVICE_ID=

# --- Admin page (/admin) ------------------------------------------------------------------
# Mobile numbers that can open /admin, comma separated
ADMIN_PHONES=03001234567
# Extra password for /admin (needed while SMS codes are off, because sign-in is by number only)
ADMIN_PASSWORD=

# --- Business details on the Contact / Terms / Refund pages (Safepay checks these) --------
NEXT_PUBLIC_BUSINESS_NAME=Dawatnama
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_PHONE=0300 1234567
NEXT_PUBLIC_BUSINESS_ADDRESS=Islamabad, Pakistan

# --- Card payments (Safepay: Visa / Mastercard from any bank) ---------------------------
# "card" for real payments. "demo" = test checkout with no money (ignored on Vercel
# production, so it can never give Premium away on the live site).
PAYMENT_MODE=card
# "sandbox" with your Safepay sandbox keys while testing, "production" with live keys.
SAFEPAY_ENV=sandbox
# Safepay dashboard → Developer → API keys: the public API key (starts with sec_)
SAFEPAY_API_KEY=
# Safepay dashboard → Developer → Endpoints/Webhooks: the secret key (shared secret)
SAFEPAY_SECRET_KEY=
# Only if Safepay shows a separate webhook secret; otherwise leave empty to reuse the above.
SAFEPAY_WEBHOOK_SECRET=
