# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Supabase → Project Settings → API → service_role (SECRET: server only, never NEXT_PUBLIC_)
# Used only to record payments and switch Premium on after Safepay confirms a payment.
SUPABASE_SERVICE_ROLE_KEY=
# Your live address (no trailing slash). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app

# --- Sign-in --------------------------------------------------------------------------
# "on" shows "Phone number or email". Turn on only after an SMS provider is set up in
# Supabase (Authentication → Providers → Phone). Anything else = email code only.
NEXT_PUBLIC_PHONE_LOGIN=off
# Digits in the one-time code (Supabase default 6).
NEXT_PUBLIC_OTP_LENGTH=6

# --- Premium ----------------------------------------------------------------------------
# Price in rupees. Keep both the same: the first is what is charged, the second is shown.
PREMIUM_PRICE_PKR=1499
NEXT_PUBLIC_PREMIUM_PRICE_PKR=1499

# --- Card payments (Safepay: Visa / Mastercard from any bank) ---------------------------
# "card" for real payments. "demo" = test checkout with no money (ignored on Vercel
# production, so it can never give Premium away on the live site).
PAYMENT_MODE=card
# "sandbox" with your Safepay sandbox keys while testing, "production" with live keys.
SAFEPAY_ENV=sandbox
# Safepay dashboard → Developer → API keys: the public API key (starts with sec_)
SAFEPAY_API_KEY=
# Safepay dashboard → Developer → Endpoints/Webhooks: the secret key (shared secret)
SAFEPAY_SECRET_KEY=
# Only if Safepay shows a separate webhook secret; otherwise leave empty to reuse the above.
SAFEPAY_WEBHOOK_SECRET=
