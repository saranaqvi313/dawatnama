# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Supabase → Project Settings → API → service_role (SECRET: server only, never NEXT_PUBLIC_)
# Used only to record payments and switch Premium on after Easypaisa confirms a payment.
SUPABASE_SERVICE_ROLE_KEY=
# Your live address (no trailing slash). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app

# --- Sign-in --------------------------------------------------------------------------
# "on" shows "Phone number or email". Turn on only after an SMS provider is set up in
# Supabase (Authentication → Providers → Phone). Anything else = email code only.
NEXT_PUBLIC_PHONE_LOGIN=off
# Digits in the one-time code (Supabase default 6).
NEXT_PUBLIC_OTP_LENGTH=6

# --- Premium ----------------------------------------------------------------------------
# Price in rupees. Keep both the same: the first is what is charged, the second is shown.
PREMIUM_PRICE_PKR=1499
NEXT_PUBLIC_PREMIUM_PRICE_PKR=1499

# --- Payments (Easypaisa merchant account: card + Easypaisa wallet) ----------------------
# "easypaisa" for real payments. "demo" = test checkout with no money (ignored on Vercel
# production, so it can never give Premium away on the live site).
PAYMENT_MODE=easypaisa
# "sandbox" while testing with Easypaisa's staging credentials, "production" when live.
EASYPAISA_ENV=sandbox
# From the Easypaisa merchant (OPS) portal:
EASYPAISA_STORE_ID=
# Account Settings → Generate Hash Key (16 characters)
EASYPAISA_HASH_KEY=
# Profile page → EWP account number (used to look up transactions)
EASYPAISA_ACCOUNT_NUM=
# REST API credentials Easypaisa issues for Mobile Account payments and inquiries
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
